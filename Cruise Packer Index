<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#102a43">
<title>Cruise Packer</title>
<link rel="manifest" href="manifest.json">
<style>
:root{
 --navy:#102a43;--navy2:#163b59;--blue:#287bb5;--sky:#eaf4fb;
 --bg:#f6f8fb;--card:#fff;--muted:#718096;--line:#e2e8f0;
 --green:#16855b;--greenbg:#e7f6ef;--danger:#c0392b;--shadow:0 8px 28px rgba(16,42,67,.08)
}
*{box-sizing:border-box}html{background:var(--bg)}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif;background:var(--bg);color:var(--navy);padding-bottom:92px}
header{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;padding:22px 18px 20px;position:sticky;top:0;z-index:5;box-shadow:0 4px 16px #102a4320}
header h1{margin:0;font-size:25px;letter-spacing:-.4px}header p{margin:5px 0 0;opacity:.75;font-size:13px}
main{max-width:820px;margin:auto;padding:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:14px;box-shadow:var(--shadow)}
.progress{height:10px;background:#e8eef3;border-radius:20px;overflow:hidden}.progress>div{height:100%;background:linear-gradient(90deg,#2ca36d,#16855b);width:0;border-radius:20px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.stat{padding:12px;background:#f8fafc;border-radius:13px;border:1px solid #edf1f5}.stat b{font-size:20px;display:block}.muted{color:var(--muted);font-size:13px}
button{border:0;border-radius:11px;padding:11px 14px;font-weight:750;background:var(--navy);color:#fff;cursor:pointer;transition:.15s}
button:active{transform:scale(.97)}button.secondary{background:#edf3f7;color:var(--navy)}button.danger{background:#fff0ee;color:var(--danger)}button.small{padding:7px 9px;font-size:12px}
input,select{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:11px;font-size:15px;background:#fff;color:var(--navy);outline:none}input:focus,select:focus{border-color:#8ab9d9;box-shadow:0 0 0 3px #287bb518}
label{font-size:12px;font-weight:800;display:block;margin:10px 0 5px;text-transform:uppercase;letter-spacing:.4px;color:#526b82}.row{display:flex;gap:8px;align-items:center}.row>*{flex:1}
.tabs{display:flex;gap:7px;overflow:auto;margin:4px 0 14px;padding-bottom:2px}.tabs button{white-space:nowrap;background:#e9eff4;color:#526b82}.tabs button.active{background:var(--navy);color:#fff}
.filterbar{display:flex;gap:8px;margin-bottom:12px}.filterbar input{flex:1}.filterbar select{width:auto;min-width:130px}
.item{display:flex;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}.item:last-child{border-bottom:0}
.thumb{width:56px;height:56px;border-radius:12px;object-fit:cover;background:#e9eff4;flex:none}.thumb.placeholder{display:grid;place-items:center;font-size:23px}
.itemmain{min-width:0;flex:1}.itemmain b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.itemmain small{color:var(--muted)}
.check{width:24px;height:24px;accent-color:var(--green);flex:none}
.badge{display:inline-block;padding:4px 8px;border-radius:20px;background:var(--greenbg);color:var(--green);font-size:10px;font-weight:800;margin-top:4px}.badge.off{background:#f1f4f6;color:#718096}
.empty{text-align:center;padding:25px 10px;color:var(--muted)}
.modal{position:fixed;inset:0;background:#0008;display:none;align-items:flex-end;z-index:20}.modal.open{display:flex}.sheet{background:#fff;width:100%;max-height:92vh;overflow:auto;border-radius:22px 22px 0 0;padding:20px;box-shadow:0 -10px 40px #0002}.sheet h2{margin:0 0 14px}
.photo-preview{width:100%;max-height:240px;object-fit:contain;border-radius:14px;background:#f2f5f7;margin-top:8px}
.bottom{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:9px 10px max(9px,env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(3,1fr);gap:7px;z-index:10;box-shadow:0 -5px 18px #102a4310}
.bottom button{font-size:12px;padding:10px 5px}.bottom button span{display:block;font-size:18px;line-height:18px;margin-bottom:2px}
.sectionhead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.sectionhead h2{margin:0}
.outfit-card{border:1px solid var(--line);border-radius:16px;padding:12px;margin-top:9px;background:#fff}.outfit-photos{display:flex;gap:7px;margin-bottom:9px}.outfit-photos .thumb{width:72px;height:72px}
.searchbox{position:relative}.searchbox input{padding-left:36px}.searchbox:before{content:"⌕";position:absolute;left:13px;top:8px;font-size:20px;color:#8193a5;z-index:1}

/* Visual Outfit Builder Grids inside Modal */
.builder-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:6px;max-height:160px;overflow-y:auto;padding:4px;border:1px solid var(--line);border-radius:12px;background:#f8fafc}
.builder-item{border:2px solid var(--line);border-radius:10px;padding:6px;text-align:center;cursor:pointer;background:#fff;position:relative}
.builder-item.selected{border-color:var(--blue);background:var(--sky)}
.builder-item img{width:100%;height:50px;object-fit:cover;border-radius:6px;background:#e9eff4;margin-bottom:4px}
.builder-item span{font-size:10px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

@media(min-width:650px){body{padding-bottom:20px}.bottom{position:static;max-width:820px;margin:0 auto 18px;background:transparent;border:0;box-shadow:none;padding:0;display:flex}.bottom button{flex:none}.grid{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>
<header><h1>🚢 Cruise Packer</h1><p id="tripSubtitle">Your digital cruise wardrobe</p></header>
<main>
<section id="dashboard"></section>
<div class="tabs">
<button class="active" data-tab="outfits">Outfits</button>
<button data-tab="items">Wardrobe</button>
<button data-tab="other">Other</button>
<button data-tab="export">Export</button>
</div>
<section id="content"></section>
</main>
<div class="bottom">
<button onclick="openOutfit()"><span>👕</span>Outfit</button>
<button onclick="openItem()" class="secondary"><span>🧥</span>Clothing</button>
<button onclick="openOther()" class="secondary"><span>🧳</span>Other</button>
</div>

<div class="modal" id="modal"><div class="sheet" id="sheet"></div></div>
<script>
const KEY="cruisePackerV1";
let state=JSON.parse(localStorage.getItem(KEY)||"null")||{
 trip:{name:"My Cruise",dates:""},
 items:[], outfits:[], other:[]
};
let tab="outfits"; let filters={outfits:"",items:"",other:""};
let draftOutfit={top:"",bottom:"",dress:"",shoes:""};

function save(){localStorage.setItem(KEY,JSON.stringify(state));render()}
function esc(s=""){return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
function packedCount(){let a=[...state.items,...state.other]; let total=a.length+state.outfits.length; let packed=a.filter(x=>x.packed).length+state.outfits.filter(x=>x.packed).length;return {packed,total,pct:total?Math.round(packed/total*100):0}}
function render(){
 document.getElementById("tripSubtitle").textContent=state.trip.name+(state.trip.dates?" • "+state.trip.dates:"");
 const p=packedCount();
 document.getElementById("dashboard").innerHTML=`<div class="card">
 <div class="row"><div><h2>${esc(state.trip.name)}</h2><div class="muted">${esc(state.trip.dates||"Set your cruise dates")}</div></div><button class="small secondary" onclick="editTrip()">Edit</button></div>
 <div style="margin:14px 0 7px"><b>${p.packed}/${p.total} packed</b> <span class="muted">(${p.pct}%)</span></div>
 <div class="progress"><div style="width:${p.pct}%"></div></div>
 <div class="grid" style="margin-top:12px">
 <div class="stat"><b>${state.outfits.length}</b><span class="muted">Outfits</span></div>
 <div class="stat"><b>${state.items.length}</b><span class="muted">Clothing</span></div>
 <div class="stat"><b>${state.other.length}</b><span class="muted">Other</span></div>
 <div class="stat"><b>${state.items.filter(i=>i.category==="Shoes").length}</b><span class="muted">Shoes</span></div>
 </div></div>`;
 document.querySelectorAll(".tabs button").forEach(b=>b.classList.toggle("active",b.dataset.tab===tab));
 document.getElementById("content").innerHTML=tab==="outfits"?outfitsView():tab==="items"?itemsView():tab==="other"?otherView():exportView();
}
function img(src){return src?`<img class="thumb" src="${src}">`:`<div class="thumb placeholder">👕</div>`}
function outfitsView(){
 let q=filters.outfits.toLowerCase();
 let html=`<div class="card"><div class="sectionhead"><div><h2>Outfits</h2><div class="muted">Build complete looks from your wardrobe.</div></div><button onclick="openOutfit()">＋ Add</button></div>
 <div class="filterbar"><div class="searchbox" style="flex:1"><input placeholder="Search outfits…" value="${esc(filters.outfits)}" oninput="filters.outfits=this.value;render()"></div>
 <select onchange="filters.outfits=this.value==='All'?filters.outfits: this.value;render()"><option>All</option><option>Day outfit</option><option>Ashore</option><option>Dinner</option><option>Dress up</option></select></div></div>`;
 const groups=["Day outfit","Ashore","Dinner","Dress up"];
 for(const g of groups){
  const list=state.outfits.filter(o=>(!q||(`${o.name} ${o.occasion}`).toLowerCase().includes(q))&&o.occasion===g);
  if(!list.length) continue;
  html+=`<div class="card"><h3>${g}</h3>`;
  list.forEach(o=>{
   let top=state.items.find(x=>x.id===o.top), bottom=state.items.find(x=>x.id===o.bottom), dress=state.items.find(x=>x.id===o.dress), shoes=state.items.find(x=>x.id===o.shoes);
   html+=`<div class="outfit-card"><div class="outfit-photos">${img(top?.photo||dress?.photo)}${img(bottom?.photo)}${img(shoes?.photo)}</div>
   <div class="row"><div class="itemmain"><b>${esc(o.name)}</b><small>${[top?.name||dress?.name,bottom?.name,shoes?.name].filter(Boolean).join(" • ")||"No pieces selected"}</small><br><span class="badge ${o.packed?"":"off"}">${o.packed?"Packed":"Not packed"}</span></div>
   <input class="check" type="checkbox" ${o.packed?"checked":""} onchange="togglePacked('outfits','${o.id}',this.checked)">
   <button class="small secondary" onclick="editOutfit('${o.id}')">Edit</button></div></div>`;
  }); html+=`</div>`;
 }
 if(!state.outfits.length) html+=`<div class="card empty">No outfits yet. Tap <b>Outfit</b> below to create your first look.</div>`;
 return html;
}
function itemsView(){
 let q=filters.items.toLowerCase();
 let cats=["Top","Bottom","Dress","Shorts","Jacket","Shoes","Other"];
 let filtered=state.items.filter(i=>`${i.name} ${i.category}`.toLowerCase().includes(q));
 return `<div class="card"><div class="sectionhead"><div><h2>Wardrobe</h2><div class="muted">Your reusable clothing and shoes.</div></div><button onclick="openItem()">＋ Add</button></div>
 <div class="filterbar"><div class="searchbox" style="flex:1"><input placeholder="Search clothing…" value="${esc(filters.items)}" oninput="filters.items=this.value;render()"></div>
 <select onchange="filterItemsCategory(this.value)"><option value="All">All types</option>${cats.map(c=>`<option>${c}</option>`).join("")}</select></div></div>`+
 cats.map(c=>{let l=filtered.filter(x=>x.category===c);if(!l.length)return"";return `<div class="card"><h3>${c}</h3>`+l.map(i=>`<div class="item">${img(i.photo)}<div class="itemmain"><b>${esc(i.name)}</b><small>${esc(i.category)}</small><br><span class="badge ${i.packed?"":"off"}">${i.packed?"Packed":"Not packed"}</span></div><input class="check" type="checkbox" ${i.packed?"checked":""} onchange="togglePacked('items','${i.id}',this.checked)"><button class="small secondary" onclick="editItem('${i.id}')">Edit</button></div>`).join("")+`</div>`}).join("")+
 (!filtered.length?`<div class="card empty">No clothing matches your filter.</div>`:"");
}
function filterItemsCategory(v){
 if(v==="All"){render();return}
 let q=filters.items.toLowerCase();
 let matches=state.items.filter(i=>i.category===v&&`${i.name} ${i.category}`.toLowerCase().includes(q));
 document.getElementById("content").innerHTML=`<div class="card"><div class="sectionhead"><div><h2>${v}</h2><div class="muted">${matches.length} item${matches.length===1?"":"s"}</div></div><button onclick="openItem()">＋ Add</button></div>${matches.map(i=>`<div class="item">${img(i.photo)}<div class="itemmain"><b>${esc(i.name)}</b><small>${esc(i.category)}</small><br><span class="badge ${i.packed?"":"off"}">${i.packed?"Packed":"Not packed"}</span></div><input class="check" type="checkbox" ${i.packed?"checked":""} onchange="togglePacked('items','${i.id}',this.checked)"><button class="small secondary" onclick="editItem('${i.id}')">Edit</button></div>`).join("")||`<div class="empty">No items here.</div>`}</div>`;
}
function otherView(){
 let q=filters.other.toLowerCase();
 let list=state.other.filter(i=>`${i.name} ${i.type}`.toLowerCase().includes(q));
 return `<div class="card"><div class="sectionhead"><div><h2>Other packing</h2><div class="muted">Everything that isn't part of an outfit.</div></div><button onclick="openOther()">＋ Add</button></div>
 <div class="filterbar"><div class="searchbox" style="flex:1"><input placeholder="Search items…" value="${esc(filters.other)}" oninput="filters.other=this.value;render()"></div>
 <select onchange="filterOtherType(this.value)"><option>All types</option><option>Underwear</option><option>Toiletries</option><option>Documents</option><option>Electronics</option><option>Swimwear</option><option>Other</option></select></div></div>
 <div class="card">${list.length?list.map(i=>`<div class="item"><div class="thumb placeholder">${i.type==="Toiletries"?"🧴":i.type==="Documents"?"📄":i.type==="Electronics"?"🔌":i.type==="Underwear"?"🩲":"📦"}</div><div class="itemmain"><b>${esc(i.name)}</b><small>${esc(i.type)} • Qty ${i.qty}</small><br><span class="badge ${i.packed?"":"off"}">${i.packed?"Packed":"Not packed"}</span></div><input class="check" type="checkbox" ${i.packed?"checked":""} onchange="togglePacked('other','${i.id}',this.checked)"><button class="small secondary" onclick="editOther('${i.id}')">Edit</button></div>`).join(""):`<div class="empty">Nothing matches your filter.</div>`}</div>`;
}
function filterOtherType(v){
 if(v==="All types"){render();return}
 let q=filters.other.toLowerCase();
 let list=state.other.filter(i=>i.type===v&&`${i.name} ${i.type}`.toLowerCase().includes(q));
 document.getElementById("content").innerHTML=`<div class="card"><div class="sectionhead"><div><h2>${v}</h2><div class="muted">${list.length} item${list.length===1?"":"s"}</div></div><button onclick="openOther()">＋ Add</button></div>${list.map(i=>`<div class="item"><div class="thumb placeholder">📦</div><div class="itemmain"><b>${esc(i.name)}</b><small>${esc(i.type)} • Qty ${i.qty}</small></div><input class="check" type="checkbox" ${i.packed?"checked":""} onchange="togglePacked('other','${i.id}',this.checked)"><button class="small secondary" onclick="editOther('${i.id}')">Edit</button></div>`).join("")||`<div class="empty">No items here.</div>`}</div>`;
}
function exportView(){
 return `<div class="card"><h2>Export packing list</h2><p class="muted">Create a simple list you can save, print or share.</p>
 <button onclick="downloadTxt()">Download .txt</button> <button class="secondary" onclick="copyList()">Copy list</button>
 <button class="secondary" onclick="window.print()">Print / Save PDF</button>
 <pre id="exportText" style="white-space:pre-wrap;margin-top:14px;background:#f7fafc;padding:14px;border-radius:12px">${esc(makeList())}</pre></div>`;
}
function makeList(){
 let s=`${state.trip.name}\n${state.trip.dates}\n\nCRUISE PACKING LIST\n====================\n`;
 ["Day outfit","Ashore","Dinner","Dress up"].forEach(g=>{s+=`\n${g.toUpperCase()}\n`;state.outfits.filter(o=>o.occasion===g).forEach(o=>{let top=state.items.find(x=>x.id===o.top),bot=state.items.find(x=>x.id===o.bottom),dress=state.items.find(x=>x.id===o.dress),sh=state.items.find(x=>x.id===o.shoes);s+=`${o.packed?"☑":"☐"} ${o.name}${top?` — ${top.name}`:""}${dress?` — ${dress.name}`:""}${bot?` + ${bot.name}`:""}${sh?` + ${sh.name}`:""}\n`})});
 s+="\nCLOTHING / SHOES\n";state.items.forEach(i=>s+=`${i.packed?"☑":"☐"} ${i.name} (${i.category})\n`);
 s+="\nOTHER\n";state.other.forEach(i=>s+=`${i.packed?"☑":"☐"} ${i.name} — Qty ${i.qty} (${i.type})\n`);
 return s;
}
function downloadTxt(){let a=document.createElement("a");a.href=URL.createObjectURL(new Blob([makeList()],{type:"text/plain"}));a.download="cruise-packing-list.txt";a.click()}
async function copyList(){await navigator.clipboard.writeText(makeList());alert("Packing list copied.")}
function togglePacked(type,id,v){let x=state[type].find(x=>x.id===id);if(x)x.packed=v;save()}
function openModal(html){document.getElementById("sheet").innerHTML=html;document.getElementById("modal").classList.add("open")}
function closeModal(){document.getElementById("modal").classList.remove("open")}
document.getElementById("modal").addEventListener("click",e=>{if(e.target.id==="modal")closeModal()})
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function editTrip(){openModal(`<h2>Trip details</h2><label>Cruise name</label><input id="tname" value="${esc(state.trip.name)}"><label>Dates</label><input id="tdates" value="${esc(state.trip.dates)}" placeholder="22–30 October 2026"><div style="margin-top:15px"><button onclick="state.trip={name:document.getElementById('tname').value||'My Cruise',dates:document.getElementById('tdates').value};save();closeModal()">Save</button></div>`)}
function photoInput(existing=""){return `<label>Photo</label><input id="photo" type="file" accept="image/*" capture="environment">${existing?`<img class="photo-preview" src="${existing}">`:""}<div class="muted">On your phone, this can open the camera.</div>`}
function openItem(id=null){let i=id?state.items.find(x=>x.id===id):{name:"",category:"Top",photo:"",packed:false};openModal(`<h2>${id?"Edit":"Add"} clothing</h2><label>Name</label><input id="iname" value="${esc(i.name)}" placeholder="e.g. Blue polo"><label>Category</label><select id="icat">${["Top","Bottom","Dress","Shorts","Jacket","Shoes","Other"].map(x=>`<option ${x===i.category?"selected":""}>${x}</option>`).join("")}</select>${photoInput(i.photo)}<div class="row" style="margin-top:15px"><button onclick="saveItem('${id||""}')">Save</button>${id?`<button class="danger" onclick="deleteItem('${id}')">Delete</button>`:""}<button class="secondary" onclick="closeModal()">Cancel</button></div>`)}
function editItem(id){openItem(id)}
function saveItem(id){let file=document.getElementById("photo").files[0];let finish=photo=>{let x=id?state.items.find(x=>x.id===id):{id:uid(),packed:false};x.name=document.getElementById("iname").value||"Unnamed item";x.category=document.getElementById("icat").value;if(photo!==undefined)x.photo=photo;if(!id)state.items.push(x);save();closeModal()};if(file){let r=new FileReader();r.onload=()=>finish(r.result);r.readAsDataURL(file)}else finish(undefined)}
function deleteItem(id){state.items=state.items.filter(x=>x.id!==id);state.outfits.forEach(o=>{if(o.top===id)o.top="";if(o.bottom===id)o.bottom="";if(o.dress===id)o.dress="";if(o.shoes===id)o.shoes=""});save();closeModal()}

// Visual Builder Functions
function selectBuilderItem(category, id){
 draftOutfit[category] = draftOutfit[category] === id ? "" : id;
 updateBuilderUI();
}

function updateBuilderUI(){
 const renderGrid=(cat, containerId)=>{
  let items=state.items.filter(i=>i.category===cat);
  if(!items.length) { document.getElementById(containerId).innerHTML=`<div class="muted" style="grid-column:span 3;text-align:center;padding:10px;">No ${cat.toLowerCase()}s in wardrobe</div>`; return; }
  document.getElementById(containerId).innerHTML=items.map(i=>`
   <div class="builder-item ${draftOutfit[cat.toLowerCase()||cat]===i.id?'selected':''}" onclick="selectBuilderItem('${cat.toLowerCase()||cat}','${i.id}')">
    ${img(i.photo)}
    <span>${esc(i.name)}</span>
   </div>
  `).join('');
 };
 renderGrid('Top', 'builder-top-grid');
 renderGrid('Bottom', 'builder-bottom-grid');
 renderGrid('Dress', 'builder-dress-grid');
 renderGrid('Shoes', 'builder-shoes-grid');
}

function openOutfit(id=null){
 let o=id?state.outfits.find(x=>x.id===id):{name:"",occasion:"Day outfit",top:"",bottom:"",dress:"",shoes:"",packed:false};
 draftOutfit={top:o.top,bottom:o.bottom,dress:o.dress,shoes:o.shoes};
 openModal(`<h2>${id?"Edit":"Add"} outfit</h2>
 <label>Outfit name</label><input id="oname" value="${esc(o.name)}" placeholder="e.g. Port Vila casual">
 <label>Occasion</label><select id="oocc">${["Day outfit","Ashore","Dinner","Dress up"].map(x=>`<option ${x===o.occasion?"selected":""}>${x}</option>`).join("")}</select>
 
 <label>Tap Top</label><div id="builder-top-grid" class="builder-grid"></div>
 <label>Tap Bottom</label><div id="builder-bottom-grid" class="builder-grid"></div>
 <label>Tap Dress (Alternative to Top/Bottom)</label><div id="builder-dress-grid" class="builder-grid"></div>
 <label>Tap Shoes</label><div id="builder-shoes-grid" class="builder-grid"></div>

 <div class="row" style="margin-top:15px"><button onclick="saveOutfit('${id||""}')">Save</button>${id?`<button class="danger" onclick="deleteOutfit('${id}')">Delete</button>`:""}<button class="secondary" onclick="closeModal()">Cancel</button></div>`);
 updateBuilderUI();
}
function editOutfit(id){openOutfit(id)}
function saveOutfit(id){
 let x=id?state.outfits.find(x=>x.id===id):{id:uid(),packed:false};
 x.name=document.getElementById("oname").value||"Unnamed outfit";
 x.occasion=document.getElementById("oocc").value;
 x.top=draftOutfit.top;
 x.bottom=draftOutfit.bottom;
 x.dress=draftOutfit.dress;
 x.shoes=draftOutfit.shoes;
 if(!id)state.outfits.push(x);
 save();closeModal();
}
function deleteOutfit(id){state.outfits=state.outfits.filter(x=>x.id!==id);save();closeModal()}

function openOther(id=null){let i=id?state.other.find(x=>x.id===id):{name:"",type:"Other",qty:1,packed:false};openModal(`<h2>${id?"Edit":"Add"} item</h2><label>Name</label><input id="rname" value="${esc(i.name)}" placeholder="e.g. Toothbrush"><label>Type</label><select id="rtype">${["Underwear","Toiletries","Documents","Electronics","Swimwear","Other"].map(x=>`<option ${x===i.type?"selected":""}>${x}</option>`).join("")}</select><label>Quantity</label><input id="rqty" type="number" min="1" value="${i.qty}"><div class="row" style="margin-top:15px"><button onclick="saveOther('${id||""}')">Save</button>${id?`<button class="danger" onclick="deleteOther('${id}')">Delete</button>`:""}<button class="secondary" onclick="closeModal()">Cancel</button></div>`)}
function editOther(id){openOther(id)}
function saveOther(id){let x=id?state.other.find(x=>x.id===id):{id:uid(),packed:false};x.name=document.getElementById("rname").value||"Unnamed item";x.type=document.getElementById("rtype").value;x.qty=Math.max(1,Number(document.getElementById("rqty").value)||1);if(!id)state.other.push(x);save();closeModal()}
function deleteOther(id){state.other=state.other.filter(x=>x.id!==id);save();closeModal()}
document.querySelectorAll(".tabs button").forEach(b=>b.onclick=()=>{tab=b.dataset.tab;render()});
if(!state.trip.name)editTrip(); else render();
</script>
</body></html>
